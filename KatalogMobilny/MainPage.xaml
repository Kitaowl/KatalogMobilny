<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="KatalogMobilny.MainPage">
    <!-- całość zamykamy w znaczniku grid -->

    <Grid Padding="16" RowSpacing="12" ColumnSpacing="12">
        
        <!-- definijujemy ile jest wierszy i kolumn-->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- zdecydujemy się na 5 wierszy -->
            <!-- auto oznacza tyle ile musisz zeby zmieścić zawartość -->
            <RowDefinition Height="Auto"/>
            <!-- * oznacza, że wiersz zajmie pozostała dostępna przestrzeń -->
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <!-- zdecydujemey się na 2 kolumny identycznej szeokści -->
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <!-- po definicjach wierszy i kolumn możemy umieszczać elementy w gridzie -->
        <!-- labelka w pierwszym wierszu i pierwszym kolumnie, zajmuje dwie kolumny -->
        <Label Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Text="Processor" FontSize="18" TextColor="#008BFF" HorizontalOptions="Center" Margin="0, 20"/>
        <!-- obrazek analogicznie drugi wiersz, zajmie dwie kolumny -->
        <Image Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Source="processor.png" Aspect="AspectFit"/>
        <!-- labelka znowu na całą szerokość ale w trzecim wierszu -->
        <Label Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Text="Cena: 899 zł" FontSize="30" TextColor="Gray"/>
        <!-- labelka z wynikiem skryptu -->
        <Label Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" x:Name="EtykietaWyniku" Text="Nic nie wybrano"/>
        <!-- UWAGA: zamiast horizontalstacklayout możemy użyć grid -->

        <Button Grid.Row="5" Grid.Column="0" Text="Pokaż" Clicked="PokazClicked" HeightRequest="52" HorizontalOptions="Fill"/>
        
        <Button Grid.Row="5" Grid.Column="1" Text="Ukryj" HeightRequest="52"/>

        <FlexLayout Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Wrap="Wrap" JustifyContent="Start" Padding="10">
            
            <Button Text="Procesory" HeightRequest="44" Margin="4"/>
            <Button Text="Płyty główne" HeightRequest="44" Margin="4"/>
            <Button Text="Karty graficzne" HeightRequest="44" Margin="4"/>
            <Button Text="Dyski SSD" HeightRequest="44" Margin="4"/>
            <Button Text="Pamięci RAM" HeightRequest="44" Margin="4"/>
            
        </FlexLayout>
    </Grid>
</ContentPage>