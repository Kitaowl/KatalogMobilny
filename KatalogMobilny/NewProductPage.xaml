<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="KatalogMobilny.NewProductPage"
             Title="NewProductPage">

    <Grid RowDefinitions="*,Auto">

        <VerticalStackLayout Grid.Row="0" Padding="16" Spacing="12">
            <Label
            Text="Nowy produkt"
            VerticalOptions="Center"
            HorizontalOptions="Center" />
            <Label Text="Nazwa"/>

            <Entry x:Name="NazwaEntry" Placeholder="Wpisz nazwę produktu" HeightRequest="44"/>
            <Label Text="Cena"/>
            <Entry x:Name="CenaEntry" Placeholder="0" Keyboard="Numeric" HeightRequest="44"/>
            <Label Text="Kategoria"/>

            <Picker x:Name="KategoriaPicker" HeightRequest="44">
                <Picker.ItemsSource>
                    <x:Array Type="{x:Type x:String}">
                        <x:String>Procesory</x:String>
                        <x:String>Płyty główne</x:String>
                        <x:String>Karty graficzne</x:String>
                        <x:String>Dyski SSD</x:String>
                        <x:String>Pamięci RAM</x:String>
                    </x:Array>
                </Picker.ItemsSource>
            </Picker>

            <HorizontalStackLayout Spacing="12" MinimumHeightRequest="44">
                <Switch x:Name="AvailableSwitch"/>
                <Label Text="Produkt dostępny" VerticalOptions="Center"/>
            </HorizontalStackLayout>
        </VerticalStackLayout>

        <VerticalStackLayout Grid.Row="1" Margin="16" Spacing="8">
            <Button Text="Dodaj produkty"
                HeightRequest="52"
                Clicked="DodajProdukty_Clicked"/>

            <Button Text="Resetuj produkty"
                HeightRequest="52"
                Clicked="ResetujProdukty_Clicked"/>

            <Label x:Name="KliknietoLabel"
                Text="Kliknięto 0 razy"/>
        </VerticalStackLayout>
    </Grid>
</ContentPage>